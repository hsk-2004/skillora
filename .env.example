# SkillOra - the ONE env file for backend, frontend and deployment. Git-ignored. Template: .env.example

# --- LLM ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACKS=gemini-flash-latest,gemini-3.5-flash
USE_LLM=1
GITHUB_TOKEN=

# --- Database (Postgres via docker compose; remove to fall back to SQLite) ---
DB_URL=postgresql+psycopg://skillora:skillora_dev_pw@localhost:5433/skillora
POSTGRES_PASSWORD=skillora_dev_pw
JWT_SECRET=skillora-development-secret-key-change-in-production

# --- Frontend <-> backend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_URL=http://127.0.0.1:8000

# --- A2A (requirement 6) ---
A2A_ENABLED=1
A2A_SHARED_KEY=change-me

# --- Langfuse tracing (requirement 9) ---
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_HOST=https://cloud.langfuse.com
